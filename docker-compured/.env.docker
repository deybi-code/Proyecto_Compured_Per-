# Copia este archivo como .env en la raíz del proyecto
# y rellena los valores antes de hacer docker compose up

# Genera uno con: php artisan key:generate --show
APP_KEY=base64:CAMBIA_ESTO_CON_TU_KEY

# Contraseña para el usuario de la app en MySQL
DB_PASSWORD=una_contrasena_segura_aqui

# Contraseña root de MySQL (solo para administración local)
DB_ROOT_PASSWORD=root_password_seguro
